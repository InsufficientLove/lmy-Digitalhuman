[Unit]
Description=MuseTalk 实时推理服务
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/musetalk/repo/MuseTalkEngine
Environment="PORT=8888"
Environment="GPU_ID=1"
Environment="WHISPER_MODEL_PATH=/opt/musetalk/models/whisper"
ExecStart=/usr/bin/python3 /opt/musetalk/repo/MuseTalkEngine/main_realtime.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
