# MuseTalk 实时推理服务 - 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改

# ===== MuseTalk 路径配置 =====
# MuseTalk 源码目录
MUSE_TALK_DIR=/opt/musetalk/repo/MuseTalk

# 模型路径（通常在 MuseTalk 目录下）
MODEL_PATH=/opt/musetalk/models
MUSETALK_MODEL_PATH=/opt/musetalk/models

# ===== 资产路径配置 =====
# 默认视频路径
AVATAR_VIDEO_PATH=./data/video/idle.mp4

# 预处理输出目录
PREPROCESSED_DIR=./data/preprocessed

# 模板缓存目录
MUSE_TEMPLATE_CACHE_DIR=/opt/musetalk/template_cache

# ===== 服务配置 =====
# 服务端口
PORT=8000

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 工作线程数（通常设为 1，因为模型在内存中）
WORKERS=1

# ===== GPU 优化配置 =====
# 是否启用 torch.compile (PyTorch 2.0+)
# 启用后首次推理会慢，但后续推理会加速 20-30%
USE_TORCH_COMPILE=0

# 是否启用 CUDA 图优化（实验性）
ENABLE_CUDA_GRAPHS=0

# 禁用 torch.compile（如遇到兼容性问题）
DISABLE_TORCH_COMPILE=0

# 默认批处理大小
DEFAULT_BATCH_SIZE=8

# CUDA 设备（多卡时可选择）
CUDA_VISIBLE_DEVICES=0,1

# ===== 推理参数 =====
# 默认帧率
DEFAULT_FPS=25

# 音频采样率
AUDIO_SAMPLE_RATE=16000

# 音频填充长度（左右）
AUDIO_PADDING_LEFT=2
AUDIO_PADDING_RIGHT=2

# ===== 性能监控 =====
# 是否启用性能监控
PERFORMANCE_MONITORING=false

# 监控日志文件
PERFORMANCE_LOG=/var/log/musetalk_performance.log

# ===== 缓存配置 =====
# 是否启用资产缓存
ENABLE_ASSET_CACHE=true

# 缓存大小限制（MB）
MAX_CACHE_SIZE=2048

# ===== 安全配置 =====
# CORS 允许的源（逗号分隔）
CORS_ORIGINS=*

# API 密钥（可选，用于认证）
API_KEY=

# 最大音频文件大小（MB）
MAX_AUDIO_SIZE=50

# ===== 调试配置 =====
# 是否启用详细日志
VERBOSE=false

# 是否保存临时文件（用于调试）
SAVE_TEMP_FILES=false

# 临时文件目录
TEMP_DIR=/tmp/musetalk

# ===== Docker 配置 =====
# 容器内工作目录
WORK_DIR=/workspace/MuseTalkEngine

# 数据挂载目录
DATA_DIR=/workspace/data

# ===== 高级配置 =====
# PyTorch 线程数
OMP_NUM_THREADS=8
MKL_NUM_THREADS=8

# cuDNN 优化
CUDNN_BENCHMARK=1

# 禁用输出缓冲（用于实时日志）
PYTHONUNBUFFERED=1

# Python 路径
PYTHONPATH=/opt/musetalk/repo/MuseTalk:/workspace/MuseTalkEngine
